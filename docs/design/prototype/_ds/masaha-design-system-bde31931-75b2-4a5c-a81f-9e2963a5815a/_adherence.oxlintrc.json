{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "dialog",
            "message": "Use <Dialog> from the design system instead of <dialog>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "select",
            "message": "Use <Select> from the design system instead of <select>."
          },
          {
            "element": "table",
            "message": "Use <Table> from the design system instead of <table>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/Alert/**",
              "components/general/AlertDialog/**",
              "components/general/Avatar/**",
              "components/general/Badge/**",
              "components/general/Breadcrumb/**",
              "components/general/Button/**",
              "components/general/Calendar/**",
              "components/general/Card/**",
              "components/general/Checkbox/**",
              "components/general/Combobox/**",
              "components/general/DataTable/**",
              "components/general/DatePicker/**",
              "components/general/Dialog/**",
              "components/general/DropdownMenu/**",
              "components/general/EmptyState/**",
              "components/general/Field/**",
              "components/general/Input/**",
              "components/general/LanguageToggle/**",
              "components/general/Pagination/**",
              "components/general/Popover/**",
              "components/general/RadioGroup/**",
              "components/general/Select/**",
              "components/general/Separator/**",
              "components/general/Sheet/**",
              "components/general/Sidebar/**",
              "components/general/Skeleton/**",
              "components/general/Spinner/**",
              "components/general/StatCard/**",
              "components/general/Switch/**",
              "components/general/Table/**",
              "components/general/Tabs/**",
              "components/general/Textarea/**",
              "components/general/ThemeToggle/**",
              "components/general/ToggleGroup/**",
              "components/general/Tooltip/**",
              "components/toast/Toaster/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Sans Arabic))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Sans Arabic."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|icon|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:info|warning|destructive)$/]",
        "message": "<Alert> variant must be one of 'info' | 'warning' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AlertDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|open|defaultOpen|key|ref|className|style|children)$/]",
        "message": "<AlertDialog> doesn't accept that prop. Declared props: children, open, defaultOpen."
