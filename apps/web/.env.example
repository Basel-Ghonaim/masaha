# The web's settings. Copy this file to apps/web/.env (never committed), then restart the dev
# server: Vite reads it when it starts. See docs/development/setup.md › The web.

# The development server's port, and the API it forwards /api to: this folder's API, on the PORT of
# apps/api/.env, whose CORS_ORIGIN names this port. Empty: 5320 and http://localhost:3320. They
# carry no VITE_ prefix, so they never reach the browser.
WEB_PORT=
API_PROXY_TARGET=

# Google sign-in's OAuth client id: the same value as GOOGLE_CLIENT_ID in apps/api/.env, whose client
# lists http://localhost:5320 as an authorised JavaScript origin. Empty: the Google button is not shown.
VITE_GOOGLE_CLIENT_ID=
