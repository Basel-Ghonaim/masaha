{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs the build as ESM: relative imports name their .ts file, and the emit rewrites them to .js.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    // Development, tests and typechecking read @masaha/shared from its source, so it need not be built
    // first. tsconfig.build.json drops the condition and compiles against the package's dist.
    "customConditions": ["@masaha/source"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src", "test", "scripts", "prisma.config.ts", "vitest.config.ts"]
}
