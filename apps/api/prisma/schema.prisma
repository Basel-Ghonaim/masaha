// The database schema: the source of truth for every entity and field. The conventions and the
// reasoning are in docs/architecture/data-model.md. The connection URL lives in prisma.config.ts.
//
// The CHECK constraints cannot be expressed here: they are raw SQL at the end of the init
// migration. Prisma does not compare CHECK constraints, so later migrations leave them alone.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
  // Partial unique indexes (`@@unique(…, where: …)`), so Prisma knows them and never drops them.
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  OWNER
  ADMIN
}

// The web's language codes (docs/frontend/localisation.md).
enum Language {
  ar
  en
}

// A user's role at one space; it alone decides what they may do there (ADR 0009).
enum SpaceManagerRole {
  OWNER
  RECEPTION
}

enum Currency {
  ILS
}

enum PricePeriod {
  HOUR
  DAY
  WEEK
  MONTH
}

enum PriceAudience {
  GENERAL
  STUDENT
}

enum ContactType {
  WHATSAPP
  PHONE
  EMAIL
  INSTAGRAM
  FACEBOOK
  TIKTOK
  WEBSITE
}

// How a subscription or a package is charged: one fixed price, or its attendance at a rate.
enum SubscriptionBilling {
  FIXED
  PER_HOUR
  PER_DAY
}

// How a visit's stay is rounded before the hour rate applies (a space setting).
enum VisitRounding {
  /// A started hour counts in full once the space's number of minutes into it have passed.
  UP_AFTER_MINUTES
  NEAREST_HALF_HOUR
  PER_MINUTE
}

enum CheckInMethod {
  MANUAL
}

enum CheckOutMethod {
  MANUAL
  AUTO
}

// OUTAGE is a power or internet outage. An active CLOSURE makes the live status CLOSED.
enum AnnouncementType {
  GENERAL
  OUTAGE
  CLOSURE
  OFFER
  EVENT
}

// There is no capacity field: capacity is private (ADR 0008).
enum DataReportField {
  PRICES
  HOURS
  CONTACT
  LOCATION
  AMENITIES
  OTHER
}

enum DataReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ─── Users and sessions ──────────────────────────────────────────────────────────────────────

/// Signs in with a password, Google, or both; at least one (a CHECK in the accounts migration).
model User {
  id                 Int       @id @default(autoincrement())
  /// Stored lowercased.
  email              String    @unique
  /// Null for a Google-only account (docs/backend/security.md).
  passwordHash       String?   @map("password_hash")
  /// The Google account's `sub` claim, once Google is linked.
  googleSubject      String?   @unique @map("google_subject")
  name               String
  role               Role      @default(USER)
  language           Language  @default(ar)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// Users are suspended, never deleted (ADR 0007).
  suspendedAt        DateTime? @map("suspended_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  managedSpaces       SpaceManager[]
  favorites           Favorite[]
  dataReports         DataReport[]         @relation("DataReportAuthor")
  resolvedDataReports DataReport[]         @relation("DataReportResolver")
  customers           Customer[]
  auditLogs           AuditLog[]
  // Who typed a price or a charge at the desk, and who ended a subscription early.
  pricedSubscriptions Subscription[]       @relation("SubscriptionPriceSetBy")
  endedSubscriptions  Subscription[]       @relation("SubscriptionEndedBy")
  chargedVisits       Visit[]              @relation("VisitChargeSetBy")

  @@map("users")
}

model RefreshToken {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  rotatedAt    DateTime? @map("rotated_at") @db.Timestamptz(3)
  replacedById Int?      @unique @map("replaced_by_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Single use; the token is stored as its SHA-256 hash (docs/backend/security.md).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ─── Lookups ─────────────────────────────────────────────────────────────────────────────────

/// An inactive governorate or area is hidden from filters and forms, and the spaces in it are
/// not listed publicly, without deleting anything.
model Governorate {
  id        Int      @id @default(autoincrement())
  nameAr    String   @unique @map("name_ar")
  nameEn    String   @map("name_en")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  areas Area[]

  @@map("governorates")
}

model Area {
  id            Int      @id @default(autoincrement())
  governorateId Int      @map("governorate_id")
  nameAr        String   @map("name_ar")
  nameEn        String   @map("name_en")
  sortOrder     Int      @default(0) @map("sort_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  spaces      Space[]

  // Its governorate_id prefix also serves the foreign key.
  @@unique([governorateId, nameAr])
  @@map("areas")
}

model Amenity {
  id        Int      @id @default(autoincrement())
  /// snake_case, stable; code refers to amenities by key.
  key       String   @unique
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  /// A key from the fixed set the web maps to an icon.
  icon      String
  sortOrder Int      @default(0) @map("sort_order")
  /// An inactive amenity is retired: hidden from forms, its space links kept.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  spaces SpaceAmenity[]

  @@map("amenities")
}

// ─── Spaces ──────────────────────────────────────────────────────────────────────────────────

model Space {
  id                 Int       @id @default(autoincrement())
  /// Never reused, including after a soft delete.
  slug               String    @unique
  nameAr             String    @map("name_ar")
  nameEn             String?   @map("name_en")
  descriptionAr      String?   @map("description_ar")
  descriptionEn      String?   @map("description_en")
  /// Free text with landmarks.
  addressAr          String    @map("address_ar")
  addressEn          String?   @map("address_en")
  areaId             Int       @map("area_id")
  lat                Float
  lng                Float
  /// Private: only the space's owner sees it (ADR 0008). Null until set.
  capacity           Int?
  /// Auto check-out after this long, if earlier than closing time. Null = at closing only.
  maxStayMinutes     Int?      @map("max_stay_minutes")
  isHidden           Boolean   @default(false) @map("is_hidden")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(3)
  // Freshness per fact group: set when the group is saved or confirmed unchanged.
  /// Name, description, address, area, location and photos.
  profileUpdatedAt   DateTime  @default(now()) @map("profile_updated_at") @db.Timestamptz(3)
  hoursUpdatedAt     DateTime  @default(now()) @map("hours_updated_at") @db.Timestamptz(3)
  /// Prices and shifts.
  pricesUpdatedAt    DateTime  @default(now()) @map("prices_updated_at") @db.Timestamptz(3)
  amenitiesUpdatedAt DateTime  @default(now()) @map("amenities_updated_at") @db.Timestamptz(3)
  contactsUpdatedAt  DateTime  @default(now()) @map("contacts_updated_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  area          Area           @relation(fields: [areaId], references: [id], onDelete: Restrict)
  managers      SpaceManager[]
  amenities     SpaceAmenity[]
  hours         SpaceHours[]
  shifts        SpaceShift[]
  prices        SpacePrice[]
  contacts      SpaceContact[]
  photos        SpacePhoto[]
  customers     Customer[]
  packages      Package[]
  subscriptions Subscription[]
  checkIns      CheckIn[]
  visits        Visit[]
  announcements Announcement[]
  dataReports   DataReport[]
  favorites     Favorite[]
  auditLogs     AuditLog[]

  @@index([areaId])
  @@map("spaces")
}

/// A user's link to a space, as its OWNER or RECEPTION. A space with at least one active OWNER
/// link is verified (ADR 0009).
model SpaceManager {
  spaceId       Int              @map("space_id")
  userId        Int              @map("user_id")
  role          SpaceManagerRole @default(OWNER)
  /// A deactivated link grants nothing, and is kept: payments and the audit log name its user.
  deactivatedAt DateTime?        @map("deactivated_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([spaceId, userId])
  @@index([userId])
  @@map("space_managers")
}

model SpaceAmenity {
  spaceId   Int      @map("space_id")
  amenityId Int      @map("amenity_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  space   Space   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([spaceId, amenityId])
  @@index([amenityId])
  @@map("space_amenities")
}

/// One opening range per day, in minutes after midnight (Asia/Gaza). Shifts sit inside it.
/// Closing mid-day and reopening, or closing after midnight, is not supported in v1.
model SpaceHours {
  id           Int      @id @default(autoincrement())
  spaceId      Int      @map("space_id")
  /// 0 = Sunday … 6 = Saturday, as JavaScript's getDay().
  dayOfWeek    Int      @map("day_of_week")
  isClosed     Boolean  @default(false) @map("is_closed")
  opensMinute  Int?     @map("opens_minute")
  closesMinute Int?     @map("closes_minute")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, dayOfWeek])
  @@map("space_hours")
}

/// An optional named shift inside the opening range, in minutes after midnight (Asia/Gaza).
/// Part of the prices fact group.
model SpaceShift {
  id           Int      @id @default(autoincrement())
  spaceId      Int      @map("space_id")
  nameAr       String   @map("name_ar")
  nameEn       String?  @map("name_en")
  startsMinute Int      @map("starts_minute")
  endsMinute   Int      @map("ends_minute")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  prices        SpacePrice[]
  packages      Package[]
  subscriptions Subscription[]
  visits        Visit[]

  @@unique([spaceId, nameAr])
  // The target of SpacePrice's foreign key, which keeps a price's shift in its own space.
  @@unique([id, spaceId])
  @@map("space_shifts")
}

/// Every period is optional: a missing period is a missing row. One price per (space, period,
/// audience, shift, label), where a missing shift or label counts as one value: one plain general
/// monthly price, one student price, one per shift, one per label.
model SpacePrice {
  id           Int           @id @default(autoincrement())
  spaceId      Int           @map("space_id")
  period       PricePeriod
  audience     PriceAudience @default(GENERAL)
  shiftId      Int?          @map("shift_id")
  /// A custom label for a row beyond the standard ones.
  labelAr      String?       @map("label_ar")
  labelEn      String?       @map("label_en")
  amountAgorot Int           @map("amount_agorot")
  currency     Currency      @default(ILS)
  sortOrder    Int           @default(0) @map("sort_order")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space       @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  // Through spaceId too, so a price can only name a shift of its own space. NoAction, checked at
  // the end of the statement: a shift in use cannot be deleted, but a whole space still cascades.
  shift SpaceShift? @relation(fields: [shiftId, spaceId], references: [id, spaceId], onDelete: NoAction)

  // PostgreSQL treats NULLs as distinct in a unique index, so each combination of a missing shift
  // and label gets its own partial index. Their space_id prefix also serves the price list.
  @@unique([spaceId, period, audience], where: { shiftId: null, labelAr: null })
  @@unique([spaceId, period, audience, shiftId], where: { labelAr: null })
  @@unique([spaceId, period, audience, labelAr], where: { shiftId: null })
  @@unique([spaceId, period, audience, shiftId, labelAr])
  @@map("space_prices")
}

/// Phone and WhatsApp values are E.164; social and website values are full https URLs.
model SpaceContact {
  id        Int         @id @default(autoincrement())
  spaceId   Int         @map("space_id")
  type      ContactType
  value     String
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@unique([spaceId, type, value])
  @@map("space_contacts")
}

model SpacePhoto {
  id        Int      @id @default(autoincrement())
  spaceId   Int      @map("space_id")
  /// The storage key.
  path      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@index([spaceId])
  @@map("space_photos")
}

// ─── Operations ──────────────────────────────────────────────────────────────────────────────

/// Everyone on file at a space: a subscriber, or a visitor who left a debt. The phone is unique
/// within a space among customers that are not archived.
model Customer {
  id         Int       @id @default(autoincrement())
  spaceId    Int       @map("space_id")
  name       String
  /// E.164. Optional: a subscriber may have none.
  phone      String?
  /// Unused in v1.
  userId     Int?      @map("user_id")
  /// The soft delete (ADR 0007), named as the desk sees it.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]
  checkIns      CheckIn[]
  visits        Visit[]

  // Partial: an archived customer's phone can be used again. Also serves the customer list.
  @@unique([spaceId, phone], where: { archivedAt: null })
  // The target of the foreign keys that keep a customer's records in the customer's space.
  @@unique([id, spaceId])
  @@map("customers")
}

/// An owner-defined subscription template, private to the space's staff. The published prices
/// (SpacePrice) are the public packages; a subscription copies a package's terms when it is made.
model Package {
  id           Int                 @id @default(autoincrement())
  spaceId      Int                 @map("space_id")
  name         String
  /// A subscription made from it ends this many days after it starts.
  validityDays Int                 @map("validity_days")
  // Optional limits, as on a subscription.
  totalDays    Int?                @map("total_days")
  daysPerWeek  Int?                @map("days_per_week")
  hoursPerDay  Int?                @map("hours_per_day")
  totalHours   Int?                @map("total_hours")
  billing      SubscriptionBilling
  /// The whole price when FIXED; otherwise the rate per hour or per day.
  priceAgorot  Int                 @map("price_agorot")
  audience     PriceAudience       @default(GENERAL)
  shiftId      Int?                @map("shift_id")
  /// An inactive package is no longer offered; the subscriptions made from it keep it.
  isActive     Boolean             @default(true) @map("is_active")
  sortOrder    Int                 @default(0) @map("sort_order")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  space         Space          @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  // Through spaceId too, as on SpacePrice: only a shift of the package's own space.
  shift         SpaceShift?    @relation(fields: [shiftId, spaceId], references: [id, spaceId], onDelete: NoAction)
  subscriptions Subscription[]

  // Its space_id prefix also serves the package list.
  @@unique([spaceId, name])
  @@unique([id, spaceId])
  @@map("packages")
}

/// Any multi-day arrangement for a customer: from a package, or custom (typed at the desk). Every
/// limit is optional and only warns at check-in. The prices are a snapshot (ADR 0010). A renewal
/// adds a row.
model Subscription {
  id           Int                 @id @default(autoincrement())
  spaceId      Int                 @map("space_id")
  customerId   Int                 @map("customer_id")
  /// Null for a custom subscription.
  packageId    Int?                @map("package_id")
  name         String
  startsOn     DateTime?           @map("starts_on") @db.Date
  /// Moved to today when the subscription is ended early, and later by closure extensions.
  endsOn       DateTime?           @map("ends_on") @db.Date
  totalDays    Int?                @map("total_days")
  daysPerWeek  Int?                @map("days_per_week")
  hoursPerDay  Int?                @map("hours_per_day")
  totalHours   Int?                @map("total_hours")
  billing      SubscriptionBilling
  /// The whole price when FIXED; otherwise the rate per hour or per day.
  priceAgorot  Int                 @map("price_agorot")
  audience     PriceAudience       @default(GENERAL)
  shiftId      Int?                @map("shift_id")
  /// Who typed the price at the desk; null when it came from a package.
  priceSetById Int?                @map("price_set_by_id")
  /// Ended early: when and by whom.
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz(3)
  endedById    Int?                @map("ended_by_id")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  space      Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  // Through spaceId, so the customer, the package and the shift all belong to the same space.
  customer   Customer    @relation(fields: [customerId, spaceId], references: [id, spaceId], onDelete: Restrict)
  package    Package?    @relation(fields: [packageId, spaceId], references: [id, spaceId], onDelete: NoAction)
  shift      SpaceShift? @relation(fields: [shiftId, spaceId], references: [id, spaceId], onDelete: NoAction)
  priceSetBy User?       @relation("SubscriptionPriceSetBy", fields: [priceSetById], references: [id], onDelete: Restrict)
  endedBy    User?       @relation("SubscriptionEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  checkIns   CheckIn[]

  // The targets of the foreign keys that keep a check-in with its customer, and a payment in its
  // space.
  @@unique([id, customerId])
  @@unique([id, spaceId])
  // The customer's subscriptions, latest first; and the space's, by end date (ending soon).
  @@index([customerId, endsOn])
  @@index([spaceId, endsOn])
  @@map("subscriptions")
}

/// A customer present on a subscription. Never deleted (ADR 0007).
model CheckIn {
  id             Int             @id @default(autoincrement())
  spaceId        Int             @map("space_id")
  /// Generated by the client, so a retried request never checks in twice.
  requestId      String          @map("request_id") @db.Uuid
  customerId     Int             @map("customer_id")
  subscriptionId Int             @map("subscription_id")
  checkedInAt    DateTime        @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt   DateTime?       @map("checked_out_at") @db.Timestamptz(3)
  method         CheckInMethod   @default(MANUAL)
  /// Null while the check-in is open.
  checkoutMethod CheckOutMethod? @map("checkout_method")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  space        Space        @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  // The customer is of this space, and the subscription is this customer's.
  customer     Customer     @relation(fields: [customerId, spaceId], references: [id, spaceId], onDelete: Restrict)
  subscription Subscription @relation(fields: [subscriptionId, customerId], references: [id, customerId], onDelete: Restrict)

  @@unique([spaceId, requestId])
  // At most one open check-in per customer.
  @@unique([customerId], where: { checkedOutAt: null })
  // Open check-ins per space (live status), and date ranges (reports).
  @@index([spaceId, checkedOutAt])
  @@index([spaceId, checkedInAt])
  // A subscription's progress.
  @@index([subscriptionId, checkedInAt])
  @@map("check_ins")
}

/// A same-day stay, checked in by name or as a customer and charged at check-out. Its rates are
/// copied at check-in and its charge is stored at check-out (ADR 0010). Never deleted (ADR 0007).
model Visit {
  id              Int             @id @default(autoincrement())
  spaceId         Int             @map("space_id")
  /// Generated by the client, so a retried request never checks in twice.
  requestId       String          @map("request_id") @db.Uuid
  visitorName     String?         @map("visitor_name")
  /// Set when the visit is a customer's, or when it is left unpaid (the customer with that phone).
  customerId      Int?            @map("customer_id")
  audience        PriceAudience   @default(GENERAL)
  shiftId         Int?            @map("shift_id")
  /// Copied at check-in from the space's prices; null when the space has no such price.
  hourRateAgorot  Int?            @map("hour_rate_agorot")
  dayRateAgorot   Int?            @map("day_rate_agorot")
  checkedInAt     DateTime        @default(now()) @map("checked_in_at") @db.Timestamptz(3)
  checkedOutAt    DateTime?       @map("checked_out_at") @db.Timestamptz(3)
  method          CheckInMethod   @default(MANUAL)
  /// Null while the visit is open.
  checkoutMethod  CheckOutMethod? @map("checkout_method")
  // The charge, set at check-out: the rounding in force, whether the day-price cap cut it, and the
  // amount. Null while open, and after an auto check-out that had no rate to charge.
  roundingRule    VisitRounding?  @map("rounding_rule")
  roundingMinutes Int?            @map("rounding_minutes")
  capApplied      Boolean?        @map("cap_applied")
  chargeAgorot    Int?            @map("charge_agorot")
  /// Who typed the charge at the desk, when there was no rate to compute it.
  chargeSetById   Int?            @map("charge_set_by_id")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  space       Space       @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  customer    Customer?   @relation(fields: [customerId, spaceId], references: [id, spaceId], onDelete: NoAction)
  shift       SpaceShift? @relation(fields: [shiftId, spaceId], references: [id, spaceId], onDelete: NoAction)
  chargeSetBy User?       @relation("VisitChargeSetBy", fields: [chargeSetById], references: [id], onDelete: Restrict)

  @@unique([spaceId, requestId])
  // At most one open visit per customer.
  @@unique([customerId], where: { checkedOutAt: null })
  // The target of the foreign key that keeps a payment in its visit's space.
  @@unique([id, spaceId])
  // Open visits per space (live status), and date ranges (reports, uncollected visits).
  @@index([spaceId, checkedOutAt])
  @@index([spaceId, checkedInAt])
  @@map("visits")
}

model Announcement {
  id        Int              @id @default(autoincrement())
  spaceId   Int              @map("space_id")
  type      AnnouncementType
  textAr    String           @map("text_ar")
  textEn    String?          @map("text_en")
  startsAt  DateTime         @map("starts_at") @db.Timestamptz(3)
  /// Null = until removed.
  endsAt    DateTime?        @map("ends_at") @db.Timestamptz(3)
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  space Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@index([spaceId])
  @@map("announcements")
}

model DataReport {
  id           Int              @id @default(autoincrement())
  spaceId      Int              @map("space_id")
  userId       Int              @map("user_id")
  field        DataReportField
  /// Required when field is OTHER (checked by the input schema).
  message      String?
  status       DataReportStatus @default(OPEN)
  resolvedById Int?             @map("resolved_by_id")
  resolvedAt   DateTime?        @map("resolved_at") @db.Timestamptz(3)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  space      Space @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  user       User  @relation("DataReportAuthor", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("DataReportResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([spaceId, status])
  @@index([userId])
  @@index([status])
  @@map("data_reports")
}

model Favorite {
  userId    Int      @map("user_id")
  spaceId   Int      @map("space_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  space Space @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([userId, spaceId])
  @@map("favorites")
}

/// Platform settings. The keys are fixed in code; each value is validated when read.
model Setting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}

/// Append-only, so it has no updatedAt. Never deleted (ADR 0007).
model AuditLog {
  id         Int      @id @default(autoincrement())
  /// Null = the system (for example, auto check-out).
  actorId    Int?     @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   Int?     @map("entity_id")
  spaceId    Int?     @map("space_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User?  @relation(fields: [actorId], references: [id], onDelete: Restrict)
  space Space? @relation(fields: [spaceId], references: [id], onDelete: Restrict)

  @@index([spaceId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
