# Copy to .env and adjust. The API refuses to start if a required variable is missing or invalid.

# Required: development | test | production. There is no default: development's relaxations (the log
# email mode, cookies without Secure) must never apply by accident.
NODE_ENV=development

# The port the API listens on (default: 3000)
PORT=3000

# Required. The web app's origin, the only one allowed to call the API with credentials
CORS_ORIGIN=http://localhost:5173

# Required. Signs the access tokens: a random value of at least 32 characters, never committed.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
JWT_SECRET=

# Required. PostgreSQL for the running API: the Docker Compose service on host port 5433
# (npm run db:up). The user and password are local development values only.
DATABASE_URL=postgresql://masaha:masaha@localhost:5433/masaha_dev

# Required by npm run test:api. The API test lane migrates and truncates this database, so its
# name must end in _test.
TEST_DATABASE_URL=postgresql://masaha:masaha@localhost:5433/masaha_test

# Required by npm run db:seed: the first ADMIN account. Put real values only in .env, never here.
# The password follows the policy: 8–72 characters, at least one letter and one digit.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional (default: Admin)
SEED_ADMIN_NAME=

# Optional, for npm run db:seed: the platform's public contact. When empty, the admin sets them
# later in the platform settings. WhatsApp in E.164, for example +970599000000.
SEED_CONTACT_EMAIL=
SEED_CONTACT_WHATSAPP=

# Optional, development only: SEED_DEMO=true makes npm run db:seed add a demo space with an owner,
# a reception account, packages, subscriptions, visits and payments (never with
# NODE_ENV=production). SEED_DEMO_PASSWORD is both demo accounts' password, required with it.
SEED_DEMO=
SEED_DEMO_PASSWORD=

# Optional in development, required in production: Masaha's Google OAuth client id, from the Google
# Cloud console. Without it, Google sign-in answers service_unavailable.
GOOGLE_CLIENT_ID=

# The reset email. log (the default) sends nothing and writes the link to the log: development only.
# smtp sends through the relay below, and is required outside development. For Gmail: host
# smtp.gmail.com, port 465, secure true, the account's address as user, an app password (Google
# account, Security, App passwords, with 2-step verification on), and that address in EMAIL_FROM.
# Real values only in .env, never here.
EMAIL_MODE=log
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# The sender, for example: "مساحة Masaha" <name@gmail.com>
EMAIL_FROM=

# The proxies Express trusts for the client's address, which the rate limits count by:
# a number of hops, or addresses and the names loopback, linklocal, uniquelocal. Required in
# production; elsewhere the default is loopback, the web's development server
TRUST_PROXY=loopback

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
